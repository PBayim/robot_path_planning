<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tb3_experiment_logger</name>
  <version>0.0.0</version>
  <description>
    Passive metrics logger for NavigateToPose runs: detects goals via the
    action status topic and records path, control-quality, and outcome metrics
    (time-to-goal, path length, final pose error, velocity/acceleration
    profiles, recovery count) to CSV for thesis evaluation.
  </description>
  <maintainer email="patrickwbayim@gmail.com">pat-ubuntu</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>tf_transformations</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
