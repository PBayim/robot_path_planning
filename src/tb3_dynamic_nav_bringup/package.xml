<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tb3_dynamic_nav_bringup</name>
  <version>0.0.0</version>
  <description>
    Launch files, Nav2 params, maps, worlds and RViz configs that bring up the
    TurtleBot3 dynamic-obstacle navigation system (Gazebo + Nav2 + RViz2).
  </description>
  <maintainer email="patrickwbayim@gmail.com">pat-ubuntu</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>turtlebot3_gazebo</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
